<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TelegramListener.Pages.AuthPage"
             Title="Telegram Giriş">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Telefon Numaranızı Girin" 
               FontSize="Large" 
               HorizontalOptions="Center" />

        <Entry x:Name="PhoneEntry" 
               Placeholder="+90 5XX XXX XX XX" 
               Keyboard="Telephone" />

        <Button Text="Kod Gönder" 
                Clicked="OnSendCodeClicked" 
                HorizontalOptions="Center" />

        <Frame x:Name="CodeFrame" IsVisible="False">
            <VerticalStackLayout Spacing="10">
                <Label Text="Gelen Kodu Girin" />
                <Entry x:Name="CodeEntry" 
                       Placeholder="Kod" 
                       Keyboard="Numeric" />

                <Button Text="Giriş Yap" 
                        Clicked="OnLoginClicked" 
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <Label x:Name="ErrorMessage" 
               TextColor="Red" 
               IsVisible="False" 
               HorizontalOptions="Center" />

        <ActivityIndicator x:Name="LoadingIndicator" 
                           IsRunning="False" 
                           IsVisible="False" 
                           HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
