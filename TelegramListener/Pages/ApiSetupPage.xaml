<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TelegramListener.Pages.ApiSetupPage"
             Title="Telegram API Ayarları">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Telegram API Bilgilerini Girin" 
               FontSize="Large" 
               HorizontalOptions="Center" />
        
        <Label Text="api.telegram.org adresinden alabilirsiniz" 
               FontSize="Small" 
               TextColor="Gray"
               HorizontalOptions="Center" />

        <Entry x:Name="ApiIdEntry" 
               Placeholder="API ID (Sayı)" 
               Keyboard="Numeric" />

        <Entry x:Name="ApiHashEntry" 
               Placeholder="API Hash" />

        <Button Text="Devam Et" 
                Clicked="OnContinueClicked" 
                HorizontalOptions="Center" />

        <Label x:Name="ErrorMessage" 
               TextColor="Red" 
               IsVisible="False" 
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
